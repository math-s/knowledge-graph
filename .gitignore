# Data directories
# NOTE: data/corpus/ is intentionally tracked in git — it is the canonical
#       source of truth for all text content. The SQLite DB lives on S3 and
#       is rebuilt from these files via pipeline/scripts/load_corpus_to_db.py.
data/raw/
data/processed/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.bak
data/*.bak
data/*.meta.json
pipeline/data/raw/
pipeline/data/checkpoints/

# Bend generated artifacts (regenerable from SQLite via export_graph_for_bend.py)
bend/graph_data.bend
bend/labels.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
venv/
pipeline/.venv/

# Next.js
web/.next/
web/out/
web/node_modules/

# Environment
.env
.env.local
.env*.local

# Claude Code session state
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
pipeline/data/
